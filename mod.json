{
  "geode": "5.10.1",
  "gd": {
    "win": "2.2081",
    "android": "2.2081",
    "mac": "2.2081",
    "ios": "2.2081"
  },
  "version": "2.0.0",
  "id": "user95401.main-menu-background",
  "name": "Background Video Menu",
  "developers": [ "Mituxs", "lil2kki" ],
  "description": "High-performance video & image background player with hardware acceleration, interactive mouse framing, and multi-scene support.",
  "tags": [ "interface", "utility", "customization" ],
  "links": {
    "source": "https://github.com/lil2kki/Menu-Background",
    "community": "https://discord.gg/kXjQ8QEWNU"
  },
  "settings": {
    "BACKGROUND_FILE": {
      "type": "file",
      "name": "Default Background File",
      "description": "Default background media file used for Main Menu.",
      "default": "background.png",
      "control": {
        "dialog": "open",
        "filters": [
          {
            "description": "Supported Media Files",
            "files": [ "*.mp4", "*.mov", "*.wmv", "*.webm", "*.m4v", "*.avi", "*.png", "*.jpg", "*.jpeg", "*.gif", "*.webp", "*.jxl", "*.qoi" ]
          }
        ]
      }
    }
  }
}
